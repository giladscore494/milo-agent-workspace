# MILO production operator configuration — TEMPLATE.
#
# Copy to a private location and fill in. This file holds ONLY non-secret
# identifiers: project names, region, resource names, service-account emails
# and Secret Manager RESOURCE NAMES. Never put a secret VALUE here.
#
#   cp config/production-operator.env.example config/production-operator.env
#   $EDITOR config/production-operator.env
#
# `config/production-operator.env` is git-ignored. Every script in the
# activation bundle reads it, so the operator supplies these once:
#
#   scripts/deploy/production-preflight.sh
#   scripts/catalog/government-production-capture.sh
#   scripts/deploy/production-verify.sh
#   scripts/deploy/production-activate.sh
#   scripts/deploy/gcp-bootstrap.sh
#
# Defaults shown are the values scripts/deploy/cloud-run.sh already uses, so
# an unchanged production stack needs only the entries marked FILL IN.

# --- GCP ---------------------------------------------------------------
GCP_PROJECT_ID=big-cabinet-457321-t7
GCP_REGION=us-central1
ARTIFACT_REGISTRY_REPOSITORY=milo-agent

# Project NUMBER (not id). Used by the Vercel gateway's workload-identity
# audience. Read it once with:
#   gcloud projects describe <GCP_PROJECT_ID> --format='value(projectNumber)'
GCP_PROJECT_NUMBER=

# --- Cloud Run resources ----------------------------------------------
CLOUD_RUN_API_SERVICE=milo-agent-api
CLOUD_RUN_WORKER_JOB=milo-agent-worker
# The dedicated, bounded Government capture job. Created by
# government-production-capture.sh --ensure-job; it runs the existing worker
# image with the existing operator-capture entrypoint.
CLOUD_RUN_CAPTURE_JOB=milo-catalog-capture

# --- Service accounts --------------------------------------------------
API_SERVICE_ACCOUNT=milo-api-runtime@big-cabinet-457321-t7.iam.gserviceaccount.com
WORKER_SERVICE_ACCOUNT=milo-worker-runtime@big-cabinet-457321-t7.iam.gserviceaccount.com
# Least-privilege identity for the capture job. It needs Secret Manager
# accessor on the Supabase pair ONLY — no provider key, no job-execution
# rights, no Cloud Run invoker. Defaults to the worker identity if left
# empty, which is workable but broader than necessary.
CAPTURE_SERVICE_ACCOUNT=milo-catalog-capture@big-cabinet-457321-t7.iam.gserviceaccount.com
# The Vercel gateway's impersonated identity (workload identity federation).
GATEWAY_SERVICE_ACCOUNT=

# --- Supabase ----------------------------------------------------------
# Non-secret project reference. Both runtimes pin to it, and the capture
# refuses with CAPTURE_PROJECT_MISMATCH if it disagrees with the project the
# bound SUPABASE_URL actually points at.
SUPABASE_PROJECT_REF=

# --- Secret Manager RESOURCE NAMES (never values) -----------------------
SECRET_SUPABASE_URL=SUPABASE_URL
SECRET_SUPABASE_SERVICE_KEY=SUPABASE_SECRET_KEY
SECRET_REDIS_URL=UPSTASH_REDIS_REST_URL
SECRET_REDIS_TOKEN=UPSTASH_REDIS_REST_TOKEN
# Bound to the WORKER ONLY, and only at the paid-execution stage. Preflight
# reports whether it exists; it is never bound by the capture job.
SECRET_PROVIDER_API_KEY=KIMI_API_KEY

# --- Gateway / frontend -------------------------------------------------
# Exact production browser origin, e.g. https://milo.example.com
PRODUCTION_ORIGIN=
# Audience the API requires of the gateway's ID token.
MILO_GATEWAY_AUDIENCE=
# Comma-separated service-account emails the API accepts as the gateway.
MILO_APPROVED_GATEWAY_IDENTITIES=
VERCEL_PROJECT=

# --- Worker identity (REQUIRED by MILO_ENABLE_EXECUTION_CONTROL) --------
# The API refuses to START in production with execution control enabled and
# either of these unset (WORKER_AUTH_AUDIENCE_MISSING / WORKER_ALLOWLIST_EMPTY),
# so they are activation prerequisites, not optional hardening.
# MILO_APPROVED_WORKER_IDENTITIES defaults to WORKER_SERVICE_ACCOUNT if empty.
MILO_WORKER_AUDIENCE=
MILO_APPROVED_WORKER_IDENTITIES=

# --- Government capture identity ---------------------------------------
# The capture writes a durable run, so it needs a conversation to hang it on
# and an operator user id to attribute it to. Both are UUIDs that must already
# exist in production. `--prepare` prints what it created.
CAPTURE_CONVERSATION_ID=
CAPTURE_REQUESTED_BY=
# Distinct per capture attempt. A reused key returns the SAME run rather than
# creating a second one, which is the intended idempotent behaviour.
CAPTURE_IDEMPOTENCY_KEY=government-capture-0001

# --- Read-only database URL for migration/state checks ------------------
# NAME of an environment variable holding a read-only connection string.
# The value itself is never read from this file.
READONLY_DATABASE_URL_ENV=MILO_READONLY_DB_URL
